# Sao chép tệp này thành .env rồi điền giá trị thật.
# .env KHÔNG được đưa lên git — xem .gitignore

# ---------- Cơ sở dữ liệu ----------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=web_hen_ho

# ---------- Địa chỉ website ----------
# Để trống thì hệ thống tự nhận theo tên miền đang truy cập.
# Chỉ đặt khi muốn cố định, ví dụ khi chạy sau proxy.
APP_URL=

# Khoá mã hoá phiên đăng nhập. Sinh chuỗi mới:
#   php -r 'echo bin2hex(random_bytes(16)), "\n";'
APP_KEY=

# ---------- Máy chủ WebSocket (chat thời gian thực) ----------
# REALTIME_SECRET phải trùng với giá trị trong websoket/.env
REALTIME_SECRET=
REALTIME_WS_URL=ws://localhost:3001/ws

# ---------- Gửi email ----------
# Với Gmail phải dùng "Mật khẩu ứng dụng" 16 ký tự, không dùng mật khẩu đăng nhập.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Saigon Cupid"
